{
  "name": "amazon-listing-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic support tools and tests for the Amazon Listing Studio Skill.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "node scripts/studio.js",
    "test": "node --test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:workflow": "node --test tests/workflow/*.test.js",
    "validate:skill": "node --test tests/skill-structure.test.js",
    "validate": "node scripts/validate-state.js"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "sharp": "0.35.3"
  }
}
